# RECHERCHE LOCALE
# ============================================================
class LocalSearch:
    @staticmethod
    def full_local_search(sol: Solution, rng: random.Random) -> Solution:
        for route in sol.routes:
            rebuild_speeds(route, sol.instance)
            sol.recalc_route_energy(route)
        sol.update_from_routes()
        return sol


# ============================================================
# ALNS (boucle principale)
# ============================================================
class ALNS:
    def __init__(self, config: ALNSConfig, seed: int = 42):
        self.config = config
        self.rng = random.Random(seed)

        self.destroy_ops = [
            ("random", DestroyOperators.random_removal),
            ("worst", DestroyOperators.worst_removal),
            ("cluster", DestroyOperators.cluster_removal),
            ("shaw", DestroyOperators.shaw_removal),
            ("route", DestroyOperators.route_removal),
        ]
        self.repair_ops = [
            ("greedy", RepairOperators.greedy_insertion),
            ("regret", RepairOperators.regret_insertion),
        ]
        self.destroy_weights = [1.0] * len(self.destroy_ops)
        self.repair_weights = [1.0] * len(self.repair_ops)
        self.destroy_scores = [0.0] * len(self.destroy_ops)
        self.repair_scores = [0.0] * len(self.repair_ops)
        self.destroy_counts = [0] * len(self.destroy_ops)
        self.repair_counts = [0] * len(self.repair_ops)

    def _select_operator(self, weights):
        total = sum(weights)
        r = self.rng.random() * total
        cumsum = 0.0
        for i, w in enumerate(weights):
            cumsum += w
            if r <= cumsum:
                return i
        return len(weights)-1

    def _update_weights(self):
        cfg = self.config
        for i in range(len(self.destroy_ops)):
            if self.destroy_counts[i] > 0:
                score = self.destroy_scores[i] / self.destroy_counts[i]
                self.destroy_weights[i] = (1 - cfg.rho) * self.destroy_weights[i] + cfg.rho * score
        for i in range(len(self.repair_ops)):
            if self.repair_counts[i] > 0:
                score = self.repair_scores[i] / self.repair_counts[i]
                self.repair_weights[i] = (1 - cfg.rho) * self.repair_weights[i] + cfg.rho * score
        total_d = sum(self.destroy_weights)
        total_r = sum(self.repair_weights)
        self.destroy_weights = [w/total_d for w in self.destroy_weights]
        self.repair_weights = [w/total_r for w in self.repair_weights]
        self.destroy_scores = [0.0]*len(self.destroy_ops)
        self.repair_scores = [0.0]*len(self.repair_ops)
        self.destroy_counts = [0]*len(self.destroy_ops)
        self.repair_counts = [0]*len(self.repair_ops)

    def _compute_initial_temperature(self, instance):
        sol = build_initial_solution(instance, self.rng)
        worsening = []
        for _ in range(100):
            d_idx = self.rng.randint(0, len(self.destroy_ops)-1)
            q = max(1, int(0.1 * instance.n_targets))
            destroyed, _ = self.destroy_ops[d_idx][1](sol, q, self.rng)
            new_sol = RepairOperators.greedy_insertion(destroyed, [], self.rng)
            if new_sol.is_feasible():
                obj1 = sol.compute_objective(self.config.lambda_energy)
                obj2 = new_sol.compute_objective(self.config.lambda_energy)
                if obj2 < obj1:
                    worsening.append(obj1 - obj2)
        if not worsening:
            return 100.0
        avg = sum(worsening)/len(worsening)
        return max(avg / math.log(1.0/self.config.accept_rate_init), 0.01)

    def _accept(self, current_obj, new_obj, best_obj, temp):
        cfg = self.config
        if new_obj > best_obj + 1e-9:
            return True, cfg.sigma1
        if new_obj > current_obj + 1e-9:
            return True, cfg.sigma2
        if temp > 1e-10:
            delta = new_obj - current_obj
            if delta < 0 and self.rng.random() < math.exp(delta/temp):
                return True, cfg.sigma3
        return False, 0.0

    def solve(self, instance: Instance, verbose=False) -> Tuple[Solution, float, dict]:
        cfg = self.config
        start = time.time()
        current_sol = build_initial_solution(instance, self.rng)
        best_sol = current_sol.copy()
        current_obj = current_sol.compute_objective(cfg.lambda_energy)
        best_obj = current_obj
        if verbose:
            print(f"  initial: cov={current_sol.total_coverage:.4f}, E={current_sol.total_energy:.1f}")
        temp = self._compute_initial_temperature(instance)
        no_improve = 0
        it = 0
        stats = {'iterations': 0, 'best_iteration': 0, 'best_time': 0.0}
        for it in range(cfg.max_iter):
            if time.time() - start > cfg.time_limit:
                break
            d_idx = self._select_operator(self.destroy_weights)
            r_idx = self._select_operator(self.repair_weights)
            d_op = self.destroy_ops[d_idx][1]
            r_op = self.repair_ops[r_idx][1]

            n_covered = sum(1 for c in current_sol.covered if c)
            q = max(1, int(self.rng.uniform(cfg.q_min, cfg.q_max) * max(n_covered, 1)))
            destroyed, removed = d_op(current_sol, q, self.rng)
            new_sol = r_op(destroyed, removed, self.rng)

            if it % cfg.local_search_freq == 0:
                new_sol = LocalSearch.full_local_search(new_sol, self.rng)

            if not new_sol.is_feasible():
                continue

            new_obj = new_sol.compute_objective(cfg.lambda_energy)
            accepted, score = self._accept(current_obj, new_obj, best_obj, temp)

            if accepted:
                current_sol = new_sol
                current_obj = new_obj
                if new_obj > best_obj + 1e-9:
                    best_sol = new_sol.copy()
                    best_obj = new_obj
                    no_improve = 0
                    stats['best_iteration'] = it
                    stats['best_time'] = time.time() - start
                    if verbose and (it % 100 == 0):
                        print(f"    iter {it}: new best obj={best_obj:.6f}, cov={best_sol.total_coverage:.4f}, E={best_sol.total_energy:.1f}")
                else:
                    no_improve += 1
            else:
                no_improve += 1

            self.destroy_scores[d_idx] += score
            self.repair_scores[r_idx] += score
            self.destroy_counts[d_idx] += 1
            self.repair_counts[r_idx] += 1

            if (it+1) % cfg.segment_length == 0:
                self._update_weights()
            temp = max(0.001, temp * cfg.cooling_rate)
            if no_improve >= cfg.max_no_improve:
                break
        total_time = time.time() - start
        stats['total_time'] = total_time
        stats['iterations'] = it+1
        return best_sol, best_obj, stats


