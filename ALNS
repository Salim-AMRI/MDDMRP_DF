 #!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ALNS pour le MDDMRP-DF (Multi-Depot Drone Marine Routing Problem with Flexible Depots).

Ce fichier implemente l'algorithme decrit dans la Section 4 du manuscrit, avec
les precisions suivantes (a reporter dans le texte, voir README en fin de fichier) :

  * Representation : une route = liste ordonnee de CIBLES ; le depot de depart
    est delta_k (fixe) et le depot d'arrivee est le depot de cout minimal depuis
    la derniere cible. Une route vide = drone non active. Aucune route ne peut
    donc passer par un depot en cours de route (coherent avec le MILP).
  * Vitesses : l'energie du modele est separable par arc et il n'y a pas de
    contrainte de duree ; la vitesse optimale d'un arc est donc argmin_s e_ij^s
    (calculee une fois pour toutes). L'operateur "speed-reoptimisation" du
    manuscrit est de ce fait redondant et n'est pas implemente comme operateur.
  * Operateurs de destruction : random, worst-energy, cluster, current-sensitive.
  * Operateurs de reparation : greedy (ratio recompense / energie incrementale,
    meilleure insertion globale, jusqu'a epuisement) ; regret-2 (optionnel,
    NON present dans le manuscrit, desactive par defaut).
  * Recherche locale : 2-opt intra-route, relocate inter-route, exchange
    inter-route ; premiere amelioration ; critere = reduction de l'energie
    totale ; appliquee a chaque iteration (ls_freq = 1) jusqu'a un optimum
    local pour les trois voisinages.
  * Solution initiale (Algorithme 2) : cibles triees par w_j / e_bar_j,
    insertion de plus faible energie incrementale (equivaut a maximiser
    w_j - eps * delta_e), puis une recherche locale.
  * Critere d'acceptation : recuit simule (l'Algorithme 1 du manuscrit ne
    precise pas de critere d'acceptation : a ajouter dans le texte).
  * Classement aleatoire (puissance p, Ropke & Pisinger 2006) pour worst-energy
    et current-sensitive (ajout par rapport au manuscrit ; p = None => deterministe).
  * Scores 3 / 2 / 1 ; poids mis a jour tous les 100 iterations par
    w <- (1-rho) w + rho * theta_o / sum(theta) ; rho = 0.10.
  * Objectif : couverture ponderee - eps * energie (propulsion + chaleur de
    bord + penalite de profondeur + capteurs), eps = 1e-7 par joule : identique
    a l'objectif du MILP.

Chaque solution finale est verifiee par un validateur independant (matrices
brutes du JSON) avant d'etre enregistree.
"""

import argparse
import csv
import glob
import json
import math
import os
import random
import sys
import time
from dataclasses import dataclass
from multiprocessing import Pool, cpu_count
from typing import Dict, List, Optional, Tuple

BIG = 1e15            # cout d'un arc infaisable (jamais choisi : depasse tout budget)
INF_TIME = 1e8        # seuil M du manuscrit : tau >= M => arc infaisable
TOL = 1e-6


# ======================================================================
# CONFIGURATION
# ======================================================================
@dataclass
class Config:
    max_iter: int = 5000
    max_no_improve: int = 500
    time_limit: float = 300.0
    q_min: float = 0.05
    q_max: float = 0.30
    segment_length: int = 100
    rho: float = 0.10
    sigma_best: float = 3.0
    sigma_better: float = 2.0
    sigma_feasible: float = 1.0
    eps: float = 1e-7                      # penalite energetique (mines par joule)
    ls_freq: int = 1                       # 0 = pas de recherche locale
    accept: str = "sa"                     # "sa" ou "descent"
    accept_rate_init: float = 0.8
    cooling_rate: float = 0.995
    temp_floor: float = 1e-3
    rand_p: Optional[float] = 4.0          # None = classement deterministe
    destroy_ops: Tuple[str, ...] = ("random", "worst", "cluster", "current")
    repair_ops: Tuple[str, ...] = ("greedy",)
    adaptive: bool = True


# ======================================================================
# INSTANCE
# ======================================================================
class Instance:
    """Noeuds : 0..nd-1 = depots ; nd..nd+nt-1 = cibles."""

    def __init__(self, data: dict, name: str = ""):
        self.name = name
        depots, targets, drones = data["depots"], data["targets"], data["drones"]
        self.nd, self.nt = len(depots), len(targets)
        self.n = self.nd + self.nt
        self.speeds = list(data["drone_speeds"])
        self.S = len(self.speeds)
        self.sensor_power = float(data["sensor_power"])
        self.gamma = float(data["depth_penalty"])

        self.w = [0.0] * self.n
        self.h = [0.0] * self.n            # profondeur absolue (0 pour les depots)
        self.sens = [0.0] * self.n         # energie capteur (J) par noeud
        self.is_mine = [False] * self.n
        for j, t in enumerate(targets):
            u = self.nd + j
            self.w[u] = float(t["weight"])
            self.h[u] = abs(float(t["z"]))
            self.sens[u] = self.sensor_power * float(t["duration"])
            self.is_mine[u] = bool(t.get("is_mine", False))
        self.total_weight = sum(self.w)

        self.K = len(drones)
        self.E = [float(d["E_max"]) for d in drones]
        self.H = [float(d["H_max"]) for d in drones]
        self.start = [int(d["start_depot"]) for d in drones]

        self.xyz = [(d["x"], d["y"], d["z"]) for d in depots] + \
                   [(t["x"], t["y"], t["z"]) for t in targets]

        # matrices brutes (pour le validateur) et couts "meilleure vitesse"
        self.tm = data["time_matrices"]
        self.em = data["energy_matrices"]
        n, S = self.n, self.S
        self.c = [[BIG] * n for _ in range(n)]
        self.sp = [[0] * n for _ in range(n)]
        self.pen = [[0.0] * n for _ in range(n)]   # penalite due au courant (J)
        self.dist = [[0.0] * n for _ in range(n)]
        for i in range(n):
            xi, yi, zi = self.xyz[i]
            for j in range(n):
                if i == j:
                    continue
                xj, yj, zj = self.xyz[j]
                self.dist[i][j] = math.sqrt((xi - xj) ** 2 + (yi - yj) ** 2 + (zi - zj) ** 2)
                best, bs = BIG, 0
                for s in range(S):
                    if self.tm[s][i][j] < INF_TIME:
                        e = self.em[s][i][j]
                        if e < best:
                            best, bs = e, s
                self.c[i][j] = best
                self.sp[i][j] = bs
                if best < BIG:
                    # energie sans courant : e0 = (e - gamma*h_j) * (tau0 / tau) + gamma*h_j
                    s = bs
                    tau = self.tm[s][i][j]
                    tau0 = self.dist[i][j] / self.speeds[s]
                    g = self.gamma * self.h[j]
                    self.pen[i][j] = (best - g) * (1.0 - tau0 / tau)

        # cout de retour au depot le plus economique
        self.ret = [BIG] * n
        self.ret_depot = [0] * n
        for x in range(self.nd, n):
            best, bd = BIG, 0
            for d in range(self.nd):
                if self.c[x][d] < best:
                    best, bd = self.c[x][d], d
            self.ret[x], self.ret_depot[x] = best, bd

    def targets(self) -> range:
        return range(self.nd, self.n)


def load_instance(path: str) -> Instance:
    with open(path, "r") as f:
        data = json.load(f)
    return Instance(data, os.path.basename(path))


# ======================================================================
# SOLUTION
# ======================================================================
def route_energy(inst: Instance, k: int, r: List[int]) -> float:
    """Energie fermee (arcs + retour + capteurs) d'une route de cibles."""
    if not r:
        return 0.0
    c = inst.c
    e = c[inst.start[k]][r[0]]
    for a, b in zip(r, r[1:]):
        e += c[a][b]
    e += inst.ret[r[-1]]
    sens = inst.sens
    for x in r:
        e += sens[x]
    return e


class Solution:
    __slots__ = ("inst", "routes", "re", "visited", "cov", "energy")

    def __init__(self, inst: Instance):
        self.inst = inst
        self.routes: List[List[int]] = [[] for _ in range(inst.K)]
        self.re = [0.0] * inst.K
        self.visited = [False] * inst.n
        self.cov = 0.0
        self.energy = 0.0

    def copy(self) -> "Solution":
        s = Solution.__new__(Solution)
        s.inst = self.inst
        s.routes = [r[:] for r in self.routes]
        s.re = self.re[:]
        s.visited = self.visited[:]
        s.cov = self.cov
        s.energy = self.energy
        return s

    def touch(self, k: int):
        self.re[k] = route_energy(self.inst, k, self.routes[k])

    def finalize(self):
        inst = self.inst
        self.visited = [False] * inst.n
        cov = 0.0
        for r in self.routes:
            for u in r:
                self.visited[u] = True
                cov += inst.w[u]
        self.cov = cov
        self.energy = sum(self.re)

    def objective(self, eps: float) -> float:
        return self.cov - eps * self.energy

    def n_visited(self) -> int:
        return sum(len(r) for r in self.routes)


# ======================================================================
# DELTAS D'ENERGIE (exacts, O(1))
# ======================================================================
def ins_delta(inst: Instance, k: int, r: List[int], pos: int, u: int) -> float:
    """Variation d'energie fermee en inserant u a l'indice pos de r (capteur inclus)."""
    c, ret = inst.c, inst.ret
    if not r:
        return c[inst.start[k]][u] + ret[u] + inst.sens[u]
    if pos == 0:
        s, nx = inst.start[k], r[0]
        return c[s][u] + c[u][nx] - c[s][nx] + inst.sens[u]
    pv = r[pos - 1]
    if pos == len(r):
        return c[pv][u] + ret[u] - ret[pv] + inst.sens[u]
    nx = r[pos]
    return c[pv][u] + c[u][nx] - c[pv][nx] + inst.sens[u]


def rem_delta(inst: Instance, k: int, r: List[int], pos: int) -> float:
    """Variation d'energie fermee en retirant r[pos] (capteur inclus ; <= 0 en general)."""
    c, ret = inst.c, inst.ret
    u = r[pos]
    n = len(r)
    if n == 1:
        return -(c[inst.start[k]][u] + ret[u] + inst.sens[u])
    if pos == 0:
        s, nx = inst.start[k], r[1]
        return c[s][nx] - c[s][u] - c[u][nx] - inst.sens[u]
    pv = r[pos - 1]
    if pos == n - 1:
        return ret[pv] - c[pv][u] - ret[u] - inst.sens[u]
    nx = r[pos + 1]
    return c[pv][nx] - c[pv][u] - c[u][nx] - inst.sens[u]


def repl_delta(inst: Instance, k: int, r: List[int], pos: int, v: int) -> float:
    """Variation d'energie en remplacant r[pos] par v (capteurs inclus)."""
    c, ret = inst.c, inst.ret
    u = r[pos]
    pv = inst.start[k] if pos == 0 else r[pos - 1]
    if pos == len(r) - 1:
        d = c[pv][v] + ret[v] - c[pv][u] - ret[u]
    else:
        nx = r[pos + 1]
        d = c[pv][v] + c[v][nx] - c[pv][u] - c[u][nx]
    return d + inst.sens[v] - inst.sens[u]


def depth_ok(inst: Instance, k: int, u: int) -> bool:
    return inst.h[u] <= inst.H[k] + TOL


# ======================================================================
# RECHERCHE LOCALE (2-opt, relocate, exchange ; premiere amelioration)
# ======================================================================
def two_opt(inst: Instance, sol: Solution) -> bool:
    c, ret = inst.c, inst.ret
    improved_any = False
    for k in range(inst.K):
        r = sol.routes[k]
        while len(r) >= 2:
            n = len(r)
            v = [inst.start[k]] + r
            Fp = [0.0] * (n + 1)
            Rp = [0.0] * (n + 1)
            for m in range(n):
                Fp[m + 1] = Fp[m] + c[v[m]][v[m + 1]]
                Rp[m + 1] = Rp[m] + c[v[m + 1]][v[m]]
            found = False
            for i in range(1, n):
                a = v[i - 1]
                vi = v[i]
                for j in range(i + 1, n + 1):
                    vj = v[j]
                    if j < n:
                        nx = v[j + 1]
                        removed = c[a][vi] + (Fp[j] - Fp[i]) + c[vj][nx]
                        added = c[a][vj] + (Rp[j] - Rp[i]) + c[vi][nx]
                    else:
                        removed = c[a][vi] + (Fp[j] - Fp[i]) + ret[vj]
                        added = c[a][vj] + (Rp[j] - Rp[i]) + ret[vi]
                    d = added - removed
                    if d < -1e-9 and sol.re[k] + d <= inst.E[k] + TOL:
                        r[i - 1:j] = r[i - 1:j][::-1]
                        old = sol.re[k]
                        sol.touch(k)
                        if sol.re[k] >= old - 1e-9:      # garde-fou (ne doit pas arriver)
                            r[i - 1:j] = r[i - 1:j][::-1]
                            sol.touch(k)
                            continue
                        found = True
                        improved_any = True
                        break
                if found:
                    break
            if not found:
                break
    if improved_any:
        sol.finalize()
    return improved_any


def relocate_inter(inst: Instance, sol: Solution) -> bool:
    """Deplace une cible vers une autre route si l'energie totale diminue (premiere amelioration)."""
    c = inst.c
    improved_any = False
    while True:
        found = False
        for k1 in range(inst.K):
            r1 = sol.routes[k1]
            for p1 in range(len(r1)):
                u = r1[p1]
                rem = rem_delta(inst, k1, r1, p1)            # inclut -sens[u]
                if sol.re[k1] + rem > inst.E[k1] + TOL:      # (retrait augmentant l'energie)
                    continue
                for k2 in range(inst.K):
                    if k2 == k1 or not depth_ok(inst, k2, u):
                        continue
                    r2 = sol.routes[k2]
                    slack = inst.E[k2] + TOL - sol.re[k2]
                    for p2 in range(len(r2) + 1):
                        ins = ins_delta(inst, k2, r2, p2, u)   # inclut +sens[u]
                        if rem + ins < -1e-9 and ins <= slack:
                            before = sol.re[k1] + sol.re[k2]
                            r1.pop(p1)
                            r2.insert(p2, u)
                            sol.touch(k1)
                            sol.touch(k2)
                            if sol.re[k1] + sol.re[k2] >= before - 1e-9:   # garde-fou
                                r2.pop(p2)
                                r1.insert(p1, u)
                                sol.touch(k1)
                                sol.touch(k2)
                                continue
                            found = True
                            break
                    if found:
                        break
                if found:
                    break
            if found:
                break
        if not found:
            break
        improved_any = True
    if improved_any:
        sol.finalize()
    return improved_any


def exchange_inter(inst: Instance, sol: Solution) -> bool:
    improved_any = False
    while True:
        found = False
        for k1 in range(inst.K):
            r1 = sol.routes[k1]
            for k2 in range(k1 + 1, inst.K):
                r2 = sol.routes[k2]
                for p1 in range(len(r1)):
                    u1 = r1[p1]
                    if not depth_ok(inst, k2, u1):
                        continue
                    for p2 in range(len(r2)):
                        u2 = r2[p2]
                        if not depth_ok(inst, k1, u2):
                            continue
                        d1 = repl_delta(inst, k1, r1, p1, u2)
                        d2 = repl_delta(inst, k2, r2, p2, u1)
                        if d1 + d2 < -1e-9 and \
                                sol.re[k1] + d1 <= inst.E[k1] + TOL and \
                                sol.re[k2] + d2 <= inst.E[k2] + TOL:
                            before = sol.re[k1] + sol.re[k2]
                            r1[p1], r2[p2] = u2, u1
                            sol.touch(k1)
                            sol.touch(k2)
                            if sol.re[k1] + sol.re[k2] >= before - 1e-9:   # garde-fou
                                r1[p1], r2[p2] = u1, u2
                                sol.touch(k1)
                                sol.touch(k2)
                                continue
                            found = True
                            break
                    if found:
                        break
                if found:
                    break
            if found:
                break
        if not found:
            break
        improved_any = True
    if improved_any:
        sol.finalize()
    return improved_any


def local_search(inst: Instance, sol: Solution, deadline: float, max_cycles: int = 50) -> Solution:
    """2-opt -> relocate -> exchange, repetes jusqu'a absence d'amelioration."""
    for _ in range(max_cycles):
        if time.time() > deadline:
            break
        a = two_opt(inst, sol)
        b = relocate_inter(inst, sol)
        c = exchange_inter(inst, sol)
        if not (a or b or c):
            break
    sol.finalize()
    return sol


# ======================================================================
# REPARATION
# ======================================================================
def _best_insertion(inst: Instance, sol: Solution, k: int, u: int) -> Optional[Tuple[float, int]]:
    """Meilleure (plus faible energie incrementale) insertion faisable de u dans la route k."""
    if not depth_ok(inst, k, u):
        return None
    r = sol.routes[k]
    slack = inst.E[k] + TOL - sol.re[k]
    best, bp = None, -1
    for pos in range(len(r) + 1):
        d = ins_delta(inst, k, r, pos, u)
        if d <= slack and (best is None or d < best):
            best, bp = d, pos
    if best is None:
        return None
    return best, bp


def repair(inst: Instance, sol: Solution, mode: str) -> Solution:
    """mode = 'greedy' : maximise w/delta_e ; 'regret2' : maximise le regret sur ce ratio."""
    w = inst.w
    remaining = [u for u in inst.targets() if not sol.visited[u]]
    cache: Dict[int, List[Optional[Tuple[float, int]]]] = {
        u: [_best_insertion(inst, sol, k, u) for k in range(inst.K)] for u in remaining
    }
    while remaining:
        best_u, best_key, best_k, best_pos = None, None, -1, -1
        for u in remaining:
            lst = cache[u]
            cand = [(e[0], k, e[1]) for k, e in enumerate(lst) if e is not None]
            if not cand:
                continue
            cand.sort()
            d1, k1, p1 = cand[0]
            ratio1 = w[u] / max(d1, 1e-9)
            if mode == "regret2":
                ratio2 = w[u] / max(cand[1][0], 1e-9) if len(cand) > 1 else 0.0
                key = (ratio1 - ratio2, ratio1)
            else:
                key = (ratio1,)
            if best_key is None or key > best_key:
                best_u, best_key, best_k, best_pos = u, key, k1, p1
        if best_u is None:
            break
        sol.routes[best_k].insert(best_pos, best_u)
        sol.touch(best_k)
        remaining.remove(best_u)
        del cache[best_u]
        for u in remaining:
            cache[u][best_k] = _best_insertion(inst, sol, best_k, u)
    sol.finalize()
    return sol


# ======================================================================
# DESTRUCTION
# ======================================================================
def _remove(sol: Solution, nodes: List[int]) -> None:
    where = {}
    for k, r in enumerate(sol.routes):
        for u in r:
            where[u] = k
    touched = set()
    for u in nodes:
        k = where.get(u)
        if k is not None:
            sol.routes[k].remove(u)
            touched.add(k)
    for k in touched:
        sol.touch(k)
    sol.finalize()


def _pick_ranked(ranked: List, q: int, rng: random.Random, p: Optional[float]) -> List:
    """Selectionne q elements d'une liste classee (meilleur en tete) : deterministe ou y^p."""
    ranked = list(ranked)
    out = []
    while ranked and len(out) < q:
        if p is None:
            idx = 0
        else:
            idx = min(int(len(ranked) * (rng.random() ** p)), len(ranked) - 1)
        out.append(ranked.pop(idx))
    return out


def destroy(inst: Instance, sol: Solution, op: str, q: int, rng: random.Random,
            rand_p: Optional[float]) -> Solution:
    new = sol.copy()
    visited = [u for r in new.routes for u in r]
    if not visited:
        return new
    q = min(q, len(visited))
    if op == "random":
        rem = rng.sample(visited, q)
    elif op == "worst":
        items = []
        for k, r in enumerate(new.routes):
            for pos, u in enumerate(r):
                items.append((-rem_delta(inst, k, r, pos), u))      # economie d'energie
        items.sort(reverse=True)
        rem = [u for _, u in _pick_ranked(items, q, rng, rand_p)]
    elif op == "cluster":
        seed = rng.choice(visited)
        d = inst.dist[seed]
        rem = sorted(visited, key=lambda u: (0.0 if u == seed else d[u]))[:q]
    elif op == "current":
        arcs = []                                   # (penalite, u_depart, u_arrivee)
        for k, r in enumerate(new.routes):
            if not r:
                continue
            seq = [inst.start[k]] + r
            for a, b in zip(seq, seq[1:]):
                arcs.append((inst.pen[a][b], a, b))
        arcs.sort(reverse=True)
        rem, seen = [], set()
        ranked = list(arcs)
        while ranked and len(rem) < q:
            idx = 0 if rand_p is None else min(int(len(ranked) * (rng.random() ** rand_p)), len(ranked) - 1)
            _, a, b = ranked.pop(idx)
            for x in (a, b):
                if x >= inst.nd and x not in seen and len(rem) < q:
                    seen.add(x)
                    rem.append(x)
    else:
        raise ValueError(op)
    _remove(new, rem)
    return new


# ======================================================================
# SOLUTION INITIALE (Algorithme 2)
# ======================================================================
def build_initial(inst: Instance, eps: float) -> Solution:
    sol = Solution(inst)
    ebar = {}
    for u in inst.targets():
        ebar[u] = min(inst.c[d][u] for d in range(inst.nd)) + inst.sens[u]
    order = sorted(inst.targets(), key=lambda u: inst.w[u] / max(ebar[u], 1e-9), reverse=True)
    for u in order:
        best, bk, bp = None, -1, -1
        for k in range(inst.K):
            ins = _best_insertion(inst, sol, k, u)
            if ins is not None and (best is None or ins[0] < best):
                best, bk, bp = ins[0], k, ins[1]
        if best is not None:
            sol.routes[bk].insert(bp, u)
            sol.touch(bk)
    sol.finalize()
    return sol


# ======================================================================
# SORTIE EXPLICITE + VALIDATEUR INDEPENDANT
# ======================================================================
def explicit_routes(sol: Solution) -> List[dict]:
    inst = sol.inst
    out = []
    for k, r in enumerate(sol.routes):
        if not r:
            continue
        nodes = [inst.start[k]] + r + [inst.ret_depot[r[-1]]]
        speeds = [inst.sp[a][b] for a, b in zip(nodes, nodes[1:])]
        out.append({"drone": k, "nodes": nodes, "speeds": speeds})
    return out


def validate(inst: Instance, sol: Solution) -> Tuple[float, float]:
    """Verifie la solution contre les contraintes du MILP en n'utilisant que les matrices
    brutes. Retourne (couverture ponderee, energie totale). Leve AssertionError sinon."""
    seen = set()
    cov = 0.0
    total_e = 0.0
    for rt in explicit_routes(sol):
        k, nodes, speeds = rt["drone"], rt["nodes"], rt["speeds"]
        assert nodes[0] == inst.start[k], "depart hors delta_k"
        assert nodes[-1] < inst.nd, "la route ne se termine pas sur un depot"
        mid = nodes[1:-1]
        assert len(mid) >= 1, "drone active sans cible"
        assert all(x >= inst.nd for x in mid), "depot au milieu d'une route"
        e = 0.0
        for (a, b), s in zip(zip(nodes, nodes[1:]), speeds):
            assert inst.tm[s][a][b] < INF_TIME, "arc infaisable"
            e += inst.em[s][a][b]
        for x in mid:
            assert x not in seen, "cible visitee deux fois"
            seen.add(x)
            assert inst.h[x] <= inst.H[k] + TOL, "profondeur depassee"
            e += inst.sens[x]
            cov += inst.w[x]
        assert e <= inst.E[k] + 1e-3, "budget energetique depasse (%.3f > %.3f)" % (e, inst.E[k])
        total_e += e
    assert abs(cov - sol.cov) < 1e-9, "couverture incoherente"
    assert abs(total_e - sol.energy) < 1e-3, "energie incoherente (%.4f vs %.4f)" % (total_e, sol.energy)
    return cov, total_e


