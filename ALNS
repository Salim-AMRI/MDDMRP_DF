# FONCTIONS DE MULTIPLES RUNS ET STATISTIQUES
# ============================================================
def run_multiple(instance_file: str, num_runs: int = 30, config: ALNSConfig = None, verbose=False):
    if config is None:
        config = ALNSConfig()
    instance = load_instance(instance_file)
    total_weight = sum(instance.target_weights)

    results = []
    for seed in range(num_runs):
        if verbose:
            print(f"\n--- Run {seed+1}/{num_runs} (seed={seed}) ---")
        alns = ALNS(config, seed=seed)
        best_sol, best_obj, stats = alns.solve(instance, verbose=verbose)
        # Fermer les routes pour obtenir l'énergie finale réelle
        best_sol.close_all_routes()
        coverage_pct = (best_sol.total_coverage / total_weight) * 100
        # Nombre de drones actifs
        active_drones = sum(1 for r in best_sol.routes if len(r.nodes) > 2)
        # Mines détectées
        mines_detected = 0
        total_mines = 0
        for t in range(instance.n_targets):
            if instance.targets[t].get("is_mine", False):
                total_mines += 1
                if best_sol.covered[t]:
                    mines_detected += 1
        results.append({
            'seed': seed,
            'coverage_weighted': best_sol.total_coverage,
            'coverage_pct': coverage_pct,
            'energy_J': best_sol.total_energy,
            'time_s': stats['total_time'],
            'active_drones': active_drones,
            'mines_detected': mines_detected,
            'total_mines': total_mines,
            'iterations': stats['iterations'],
            'best_iteration': stats['best_iteration']
        })
        if verbose:
            print(f"  -> coverage={coverage_pct:.2f}%, energy={best_sol.total_energy:.1f}J, time={stats['total_time']:.2f}s")

    # Statistiques
    cov_vals = [r['coverage_pct'] for r in results]
    energy_vals = [r['energy_J'] for r in results]
    time_vals = [r['time_s'] for r in results]
    drones_vals = [r['active_drones'] for r in results]
    mines_vals = [r['mines_detected'] for r in results]

    stats_summary = {
        'instance': os.path.basename(instance_file),
        'num_runs': num_runs,
        'coverage_mean': np.mean(cov_vals),
        'coverage_std': np.std(cov_vals),
        'coverage_min': np.min(cov_vals),
        'coverage_max': np.max(cov_vals),
        'energy_mean': np.mean(energy_vals),
        'energy_std': np.std(energy_vals),
        'energy_min': np.min(energy_vals),
        'energy_max': np.max(energy_vals),
        'time_mean': np.mean(time_vals),
        'time_std': np.std(time_vals),
        'time_min': np.min(time_vals),
        'time_max': np.max(time_vals),
        'drones_mean': np.mean(drones_vals),
        'drones_std': np.std(drones_vals),
        'mines_success_rate': np.mean([1 if m == results[0]['total_mines'] else 0 for m in mines_vals]) * 100 if results[0]['total_mines'] > 0 else None,
    }
    return results, stats_summary


def print_summary(stats_summary):
    print("\n" + "="*60)
    print(f"STATISTIQUES SUR {stats_summary['num_runs']} RUNS - {stats_summary['instance']}")
    print("="*60)
    print(f"Couverture (%): moyenne={stats_summary['coverage_mean']:.2f}, std={stats_summary['coverage_std']:.3f}, min={stats_summary['coverage_min']:.2f}, max={stats_summary['coverage_max']:.2f}")
    print(f"Énergie (J): moyenne={stats_summary['energy_mean']:.1f}, std={stats_summary['energy_std']:.1f}, min={stats_summary['energy_min']:.1f}, max={stats_summary['energy_max']:.1f}")
    print(f"Temps (s): moyenne={stats_summary['time_mean']:.2f}, std={stats_summary['time_std']:.2f}, min={stats_summary['time_min']:.2f}, max={stats_summary['time_max']:.2f}")
    print(f"Drones actifs: moyenne={stats_summary['drones_mean']:.2f}, std={stats_summary['drones_std']:.3f}")
    if stats_summary['mines_success_rate'] is not None:
        print(f"Mines détectées: {stats_summary['mines_success_rate']:.1f}% des runs (toutes les mines)")
    print("="*60)


def save_results_csv(results, filename):
    with open(filename, 'w', newline='') as csvfile:
        fieldnames = ['seed', 'coverage_pct', 'energy_J', 'time_s', 'active_drones', 'mines_detected', 'total_mines', 'iterations', 'best_iteration']
        writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
        writer.writeheader()
        for r in results:
            writer.writerow({k: r[k] for k in fieldnames})


