# ============================================================
# INSTANCE
# ============================================================
@dataclass
class Instance:
    depots: List[dict]
    targets: List[dict]
    drones: List[dict]
    speeds: List[float]
    time_matrices: List[List[List[float]]]
    energy_matrices: List[List[List[float]]]
    sensor_power: float

    depot_count: int = field(init=False)
    n_targets: int = field(init=False)
    n_speeds: int = field(init=False)
    n_nodes: int = field(init=False)

    target_weights: List[float] = field(init=False)
    target_depths: List[float] = field(init=False)
    target_durations: List[float] = field(init=False)

    drone_E_max: List[float] = field(init=False)
    drone_H_max: List[float] = field(init=False)
    drone_start_depot: List[int] = field(init=False)

    coords: Dict[int, Tuple[float, float, float]] = field(default_factory=dict)
    dist_matrix: np.ndarray = field(init=False)
    best_speed_matrix: np.ndarray = field(init=False)

    max_dist: float = field(init=False)
    max_depth: float = field(init=False)
    max_weight: float = field(init=False)

    INF: float = 1e8

    def __post_init__(self):
        self.depot_count = len(self.depots)
        self.n_targets = len(self.targets)
        self.n_speeds = len(self.speeds)
        self.n_nodes = self.depot_count + self.n_targets

        self.target_weights = [t["weight"] for t in self.targets]
        self.target_depths = [t["z"] for t in self.targets]
        self.target_durations = [t["duration"] for t in self.targets]

        self.drone_E_max = [d["E_max"] for d in self.drones]
        self.drone_H_max = [d["H_max"] for d in self.drones]
        self.drone_start_depot = [d["start_depot"] for d in self.drones]

        for i, d in enumerate(self.depots):
            self.coords[i] = (d["x"], d["y"], d["z"])
        for i, t in enumerate(self.targets):
            self.coords[self.depot_count + i] = (t["x"], t["y"], t["z"])

        self.dist_matrix = np.zeros((self.n_nodes, self.n_nodes))
        for i in range(self.n_nodes):
            for j in range(self.n_nodes):
                if i != j:
                    xi, yi, zi = self.coords[i]
                    xj, yj, zj = self.coords[j]
                    self.dist_matrix[i][j] = math.sqrt((xi-xj)**2 + (yi-yj)**2 + (zi-zj)**2)

        self.max_dist = np.max(self.dist_matrix) + 1e-9
        self.max_depth = max(abs(z) for z in self.target_depths) + 1e-9
        self.max_weight = max(self.target_weights) + 1e-9

        self.best_speed_matrix = np.zeros((self.n_nodes, self.n_nodes), dtype=int)
        for i in range(self.n_nodes):
            for j in range(self.n_nodes):
                if i != j:
                    best_s = 0
                    best_e = float('inf')
                    for s in range(self.n_speeds):
                        if self.arc_feasible(i, j, s):
                            e = self.energy_matrices[s][i][j]
                            if e < best_e:
                                best_e = e
                                best_s = s
                    self.best_speed_matrix[i][j] = best_s

    def is_target(self, node: int) -> bool:
        return node >= self.depot_count

    def get_target_idx(self, node: int) -> int:
        return node - self.depot_count

    def arc_feasible(self, i: int, j: int, s: int) -> bool:
        return self.time_matrices[s][i][j] < self.INF

    def get_best_return_energy(self, from_node: int) -> Tuple[float, int, int]:
        best_e = float('inf')
        best_d = -1
        best_s = 0
        for d in range(self.depot_count):
            for s in range(self.n_speeds):
                if self.arc_feasible(from_node, d, s):
                    e = self.energy_matrices[s][from_node][d]
                    if e < best_e:
                        best_e = e
                        best_d = d
                        best_s = s
        return best_e, best_d, best_s

    def compute_closed_energy(self, route: 'DroneRoute') -> float:
        if len(route.nodes) <= 1:
            return 0.0
        if route.nodes[-1] < self.depot_count:
            return route.total_energy()
        last = route.nodes[-1]
        best_return, _, _ = self.get_best_return_energy(last)
        return route.total_energy() + best_return


# ============================================================
# DRONE ROUTE
# ============================================================
class DroneRoute:
    def __init__(self, drone_id: int, start_depot: int, E_max: float,
                 H_max: float, speed_set: List[float]):
        self.drone_id = drone_id
        self.start_depot = start_depot
        self.E_max = E_max
        self.H_max = H_max
        self.speed_set = speed_set

        self.nodes: List[int] = [start_depot]
        self.speeds: List[int] = []
        self.energy_prop = 0.0
        self.energy_sensor = 0.0
        self.end_depot: Optional[int] = None

    def copy(self):
        new = DroneRoute(self.drone_id, self.start_depot, self.E_max,
                         self.H_max, self.speed_set)
        new.nodes = self.nodes.copy()
        new.speeds = self.speeds.copy()
        new.energy_prop = self.energy_prop
        new.energy_sensor = self.energy_sensor
        new.end_depot = self.end_depot
        return new

    def total_energy(self) -> float:
        return self.energy_prop + self.energy_sensor

    def remaining_energy(self) -> float:
        return self.E_max - self.total_energy()

    def target_nodes(self, depot_count: int) -> List[int]:
        return [n for n in self.nodes if n >= depot_count]

    def target_count(self, depot_count: int) -> int:
        return len(self.target_nodes(depot_count))

    def is_empty(self) -> bool:
        return len(self.nodes) == 1

    def __repr__(self):
        return f"Route(D{self.drone_id}: {self.nodes}, E={self.total_energy():.1f}/{self.E_max:.1f})"


# ============================================================
# SOLUTION
# ============================================================
class Solution:
    def __init__(self, instance: Instance):
        self.instance = instance
        self.routes: List[DroneRoute] = []
        self.covered = [False] * instance.n_targets
        self.total_coverage = 0.0
        self.total_energy = 0.0

    def copy(self):
        new = Solution(self.instance)
        new.routes = [r.copy() for r in self.routes]
        new.covered = self.covered.copy()
        new.total_coverage = self.total_coverage
        new.total_energy = self.total_energy
        return new

    def compute_objective(self, lambda_energy: float = 1e-7) -> float:
        return self.total_coverage - lambda_energy * self.total_energy

    def update_from_routes(self):
        self.covered = [False] * self.instance.n_targets
        self.total_coverage = 0.0
        self.total_energy = 0.0
        for route in self.routes:
            self.total_energy += route.total_energy()
            for node in route.nodes:
                if self.instance.is_target(node):
                    t = self.instance.get_target_idx(node)
                    if not self.covered[t]:
                        self.covered[t] = True
                        self.total_coverage += self.instance.target_weights[t]

    def recalc_route_energy(self, route: DroneRoute):
        route.energy_prop = 0.0
        route.energy_sensor = 0.0
        for idx in range(len(route.nodes) - 1):
            i = route.nodes[idx]
            j = route.nodes[idx + 1]
            if idx < len(route.speeds):
                s = route.speeds[idx]
                route.energy_prop += self.instance.energy_matrices[s][i][j]
        for node in route.nodes:
            if self.instance.is_target(node):
                t = self.instance.get_target_idx(node)
                route.energy_sensor += self.instance.sensor_power * self.instance.target_durations[t]

    def recalc_all_energies(self):
        for route in self.routes:
            self.recalc_route_energy(route)
        self.update_from_routes()

    def is_feasible(self) -> bool:
        inst = self.instance
        visited_targets = set()
        for route in self.routes:
            closed_energy = inst.compute_closed_energy(route)
            if closed_energy > route.E_max + 1e-6:
                return False
            for node in route.nodes:
                if inst.is_target(node):
                    t = inst.get_target_idx(node)
                    if abs(inst.target_depths[t]) > route.H_max + 1e-6:
                        return False
            for idx in range(len(route.nodes) - 1):
                i, j = route.nodes[idx], route.nodes[idx + 1]
                if idx < len(route.speeds):
                    s = route.speeds[idx]
                    if not inst.arc_feasible(i, j, s):
                        return False
            if route.nodes[0] != route.start_depot:
                return False
            last = route.nodes[-1]
            if last >= inst.depot_count:
                ret, _, _ = inst.get_best_return_energy(last)
                if ret == float('inf'):
                    return False
            for node in route.nodes:
                if inst.is_target(node):
                    if node in visited_targets:
                        return False
                    visited_targets.add(node)
        return True

    def get_unassigned_targets(self) -> List[int]:
        return [t for t in range(self.instance.n_targets) if not self.covered[t]]

    def close_all_routes(self) -> None:
        inst = self.instance
        for route in self.routes:
            if len(route.nodes) <= 1:
                continue
            if route.nodes[-1] >= inst.depot_count:
                last = route.nodes[-1]
                ret_energy, best_depot, best_speed = inst.get_best_return_energy(last)
                if ret_energy < float('inf'):
                    route.nodes.append(best_depot)
                    route.speeds.append(best_speed)
                    route.energy_prop += ret_energy
                    route.end_depot = best_depot
        self.recalc_all_energies()


# ============================================================
# UTILITAIRES
# ============================================================
def rebuild_speeds(route: DroneRoute, instance: Instance):
    route.speeds = []
    for idx in range(len(route.nodes) - 1):
        i = route.nodes[idx]
        j = route.nodes[idx + 1]
        route.speeds.append(instance.best_speed_matrix[i][j])


# ============================================================
# CONSTRUCTION INITIALE
# ============================================================
def build_initial_solution(instance: Instance, rng: random.Random, alpha: float = 0.3) -> Solution:
    sol = Solution(instance)
    for k, drone in enumerate(instance.drones):
        route = DroneRoute(k, drone["start_depot"], drone["E_max"], drone["H_max"], instance.speeds)
        sol.routes.append(route)

    target_scores = []
    for t in range(instance.n_targets):
        target_node = instance.depot_count + t
        min_energy = float('inf')
        for d in range(instance.depot_count):
            e = instance.energy_matrices[0][d][target_node]
            min_energy = min(min_energy, e)
        return_est, _, _ = instance.get_best_return_energy(target_node)
        total_est = min_energy + return_est
        score = instance.target_weights[t] / (total_est + 1e-9)
        target_scores.append((t, score))
    target_scores.sort(key=lambda x: x[1], reverse=True)
    unassigned = set(t for t, _ in target_scores)

    while unassigned:
        all_insertions = []
        for t in unassigned:
            target_node = instance.depot_count + t
            depth = abs(instance.target_depths[t])
            sensor_energy = instance.sensor_power * instance.target_durations[t]
            for d_idx, route in enumerate(sol.routes):
                if depth > route.H_max + 1e-6:
                    continue
                for pos in range(len(route.nodes)):
                    prev_node = route.nodes[pos]
                    next_node = route.nodes[pos+1] if pos+1 < len(route.nodes) else None
                    is_before_depot = (next_node is not None and next_node < instance.depot_count)
                    for s_idx in range(instance.n_speeds):
                        if not instance.arc_feasible(prev_node, target_node, s_idx):
                            continue
                        old_energy = 0.0
                        new_energy = instance.energy_matrices[s_idx][prev_node][target_node]
                        if next_node is not None:
                            if not instance.arc_feasible(target_node, next_node, s_idx):
                                continue
                            if not is_before_depot:
                                old_s = route.speeds[pos] if pos < len(route.speeds) else 0
                                old_energy = instance.energy_matrices[old_s][prev_node][next_node]
                            new_energy += instance.energy_matrices[s_idx][target_node][next_node]
                        delta_prop = new_energy - old_energy
                        delta_total = delta_prop + sensor_energy
                        future_energy = 0.0
                        if next_node is not None and not is_before_depot:
                            for future_idx in range(pos+1, len(route.nodes)):
                                future_node = route.nodes[future_idx]
                                if future_idx < len(route.speeds):
                                    future_s = route.speeds[future_idx]
                                    future_next = route.nodes[future_idx+1] if future_idx+1 < len(route.nodes) else None
                                    if future_next is not None:
                                        future_energy += instance.energy_matrices[future_s][future_node][future_next]
                        last_node = target_node if is_before_depot or next_node is None else next_node
                        return_est, _, _ = instance.get_best_return_energy(last_node)
                        total_needed = delta_total + future_energy + return_est
                        if route.total_energy() + total_needed > route.E_max + 1e-6:
                            continue
                        reward = instance.target_weights[t]
                        gain = reward - 1e-7 * delta_total
                        all_insertions.append((gain, t, d_idx, pos, s_idx, is_before_depot, next_node))
        if not all_insertions:
            break
        all_insertions.sort(key=lambda x: x[0], reverse=True)
        best_gain = all_insertions[0][0]
        worst_gain = all_insertions[-1][0]
        threshold = best_gain - alpha * (best_gain - worst_gain)
        rcl = [ins for ins in all_insertions if ins[0] >= threshold]
        chosen = rng.choice(rcl)
        _, t, d_idx, pos, s_idx, is_before_depot, next_node = chosen
        target_node = instance.depot_count + t
        route = sol.routes[d_idx]
        insert_pos = pos + 1
        route.nodes.insert(insert_pos, target_node)
        rebuild_speeds(route, instance)
        sol.recalc_route_energy(route)
        unassigned.remove(t)

    sol.recalc_all_energies()
    return sol


