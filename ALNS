# DESTRUCTION (version simplifiée pour garder le code lisible)
# ============================================================
class DestroyOperators:
    @staticmethod
    def _remove_target_from_route(route: DroneRoute, target_node: int, instance: Instance):
        if target_node not in route.nodes:
            return False
        idx = route.nodes.index(target_node)
        route.nodes.pop(idx)
        rebuild_speeds(route, instance)
        route.energy_prop = 0.0
        route.energy_sensor = 0.0
        for i in range(len(route.nodes)-1):
            s = route.speeds[i]
            route.energy_prop += instance.energy_matrices[s][route.nodes[i]][route.nodes[i+1]]
        for node in route.nodes:
            if instance.is_target(node):
                t = instance.get_target_idx(node)
                route.energy_sensor += instance.sensor_power * instance.target_durations[t]
        if route.target_count(instance.depot_count) == 0:
            route.nodes = [route.start_depot]
            route.speeds = []
            route.energy_prop = 0.0
            route.energy_sensor = 0.0
            route.end_depot = None
        return True

    @staticmethod
    def random_removal(sol: Solution, q: int, rng: random.Random):
        new_sol = sol.copy()
        current = [t for t in range(sol.instance.n_targets) if sol.covered[t]]
        to_remove = rng.sample(current, min(q, len(current))) if len(current) > q else current
        removed = []
        for t in to_remove:
            target_node = sol.instance.depot_count + t
            for route in new_sol.routes:
                if DestroyOperators._remove_target_from_route(route, target_node, sol.instance):
                    removed.append(t)
                    break
        new_sol.recalc_all_energies()
        return new_sol, removed

    @staticmethod
    def worst_removal(sol: Solution, q: int, rng: random.Random):
        # Version simplifiée -> on appelle random
        return DestroyOperators.random_removal(sol, q, rng)

    @staticmethod
    def cluster_removal(sol: Solution, q: int, rng: random.Random):
        return DestroyOperators.random_removal(sol, q, rng)

    @staticmethod
    def shaw_removal(sol: Solution, q: int, rng: random.Random):
        return DestroyOperators.random_removal(sol, q, rng)

    @staticmethod
    def route_removal(sol: Solution, q: int, rng: random.Random):
        return DestroyOperators.random_removal(sol, q, rng)


# ============================================================
# RÉPARATION (version simplifiée)
# ============================================================
class RepairOperators:
    @staticmethod
    def greedy_insertion(sol: Solution, removed: List[int], rng: random.Random) -> Solution:
        new_sol = sol.copy()
        inst = sol.instance
        unassigned = set(removed + sol.get_unassigned_targets())
        candidates = sorted(unassigned, key=lambda t: inst.target_weights[t], reverse=True)
        for t in candidates:
            if new_sol.covered[t]:
                continue
            target_node = inst.depot_count + t
            depth = abs(inst.target_depths[t])
            sensor_energy = inst.sensor_power * inst.target_durations[t]
            best_gain = -1e9
            best_action = None
            for d_idx, route in enumerate(new_sol.routes):
                if depth > route.H_max + 1e-6:
                    continue
                for pos in range(len(route.nodes)):
                    prev_node = route.nodes[pos]
                    next_node = route.nodes[pos+1] if pos+1 < len(route.nodes) else None
                    is_before_depot = (next_node is not None and next_node < inst.depot_count)
                    for s_idx in range(inst.n_speeds):
                        if not inst.arc_feasible(prev_node, target_node, s_idx):
                            continue
                        old_energy = 0.0
                        new_energy = inst.energy_matrices[s_idx][prev_node][target_node]
                        if next_node is not None:
                            if not inst.arc_feasible(target_node, next_node, s_idx):
                                continue
                            if not is_before_depot:
                                old_s = route.speeds[pos] if pos < len(route.speeds) else 0
                                old_energy = inst.energy_matrices[old_s][prev_node][next_node]
                            new_energy += inst.energy_matrices[s_idx][target_node][next_node]
                        delta_prop = new_energy - old_energy
                        delta_total = delta_prop + sensor_energy
                        future_energy = 0.0
                        if next_node is not None and not is_before_depot:
                            for future_idx in range(pos+1, len(route.nodes)):
                                future_node = route.nodes[future_idx]
                                if future_idx < len(route.speeds):
                                    future_s = route.speeds[future_idx]
                                    future_next = route.nodes[future_idx+1] if future_idx+1 < len(route.nodes) else None
                                    if future_next is not None:
                                        future_energy += inst.energy_matrices[future_s][future_node][future_next]
                        last_node = target_node if is_before_depot or next_node is None else next_node
                        ret_energy, _, _ = inst.get_best_return_energy(last_node)
                        total_needed = delta_total + future_energy + ret_energy
                        if route.total_energy() + total_needed > route.E_max + 1e-6:
                            continue
                        reward = inst.target_weights[t]
                        gain = reward - 1e-7 * delta_total
                        if gain > best_gain:
                            best_gain = gain
                            best_action = (d_idx, pos, s_idx, is_before_depot, next_node)
            if best_action is not None:
                d_idx, pos, s_idx, is_before_depot, next_node = best_action
                route = new_sol.routes[d_idx]
                insert_pos = pos + 1
                route.nodes.insert(insert_pos, target_node)
                rebuild_speeds(route, inst)
                new_sol.recalc_route_energy(route)
        new_sol.recalc_all_energies()
        return new_sol

    @staticmethod
    def regret_insertion(sol: Solution, removed: List[int], rng: random.Random) -> Solution:
        # Version simplifiée -> greedy
        return RepairOperators.greedy_insertion(sol, removed, rng)


