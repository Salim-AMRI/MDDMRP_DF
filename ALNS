CSV_FIELDS = ["seed", "coverage_pct", "coverage_weighted", "energy_J", "time_s", "active_drones",
              "mines_detected", "total_mines", "mines_pct", "all_mines", "iterations", "best_iteration"]


def run_one(task):
    path, seed, cfg, save_dir = task
    inst = load_instance(path)
    best, st = ALNS(cfg, seed).solve(inst)
    cov, en = validate(inst, best)
    total_mines = sum(1 for u in inst.targets() if inst.is_mine[u])
    detected = sum(1 for u in inst.targets() if inst.is_mine[u] and best.visited[u])
    row = {
        "seed": seed,
        "coverage_pct": 100.0 * cov / inst.total_weight,
        "coverage_weighted": cov,
        "energy_J": en,
        "time_s": st["time_s"],
        "active_drones": sum(1 for r in best.routes if r),
        "mines_detected": detected,
        "total_mines": total_mines,
        "mines_pct": (100.0 * detected / total_mines) if total_mines > 0 else "",
        "all_mines": (1 if detected == total_mines else 0) if total_mines > 0 else "",
        "iterations": st["iterations"],
        "best_iteration": st["best_iteration"],
    }
    if save_dir:
        os.makedirs(save_dir, exist_ok=True)
        name = os.path.splitext(os.path.basename(path))[0]
        with open(os.path.join(save_dir, "%s_seed%d.json" % (name, seed)), "w") as f:
            json.dump({"instance": inst.name, "seed": seed, "objective": best.objective(cfg.eps),
                       "routes": explicit_routes(best), "stats": st}, f)
    return path, row


def _read_done(csv_path: str) -> Dict[int, dict]:
    done = {}
    if os.path.exists(csv_path):
        with open(csv_path, "r", newline="") as f:
            for r in csv.DictReader(f):
                try:
                    done[int(r["seed"])] = r
                except (KeyError, ValueError):
                    pass
    return done


def run_batch(paths: List[str], runs: int, cfg: Config, out_dir: str, workers: int,
              resume: bool, save_dir: Optional[str]):
    os.makedirs(out_dir, exist_ok=True)
    tasks, csv_paths, done = [], {}, {}
    for p in paths:
        name = os.path.splitext(os.path.basename(p))[0]
        cp = os.path.join(out_dir, "alns_stats_%s.csv" % name)
        csv_paths[p] = cp
        d = _read_done(cp) if resume else {}
        done[p] = d
        if not resume or not d:
            with open(cp, "w", newline="") as f:
                csv.DictWriter(f, fieldnames=CSV_FIELDS).writeheader()
        for s in range(runs):
            if s not in d:
                tasks.append((p, s, cfg, save_dir))
    print("%d instances, %d runs a executer, %d workers" % (len(paths), len(tasks), workers), flush=True)
    t0 = time.time()
    with Pool(workers) as pool:
        for n, (p, row) in enumerate(pool.imap_unordered(run_one, tasks), 1):
            with open(csv_paths[p], "a", newline="") as f:
                csv.DictWriter(f, fieldnames=CSV_FIELDS).writerow(row)
            if n % 10 == 0 or n == len(tasks):
                print("  %d/%d runs (%.0f s)" % (n, len(tasks), time.time() - t0), flush=True)
    print("Termine en %.1f s. CSV dans %s" % (time.time() - t0, out_dir))


def parse_args(argv=None):
    ap = argparse.ArgumentParser(description="ALNS MDDMRP-DF")
    ap.add_argument("instances", nargs="+", help="fichiers JSON ou dossier(s)")
    ap.add_argument("--runs", type=int, default=30)
    ap.add_argument("--out", default="results_alns")
    ap.add_argument("--workers", type=int, default=max(1, cpu_count() - 1))
    ap.add_argument("--resume", action="store_true")
    ap.add_argument("--save-solutions", default=None, help="dossier de sortie des routes (JSON)")
    ap.add_argument("--time-limit", type=float, default=300.0)
    ap.add_argument("--max-iter", type=int, default=5000)
    ap.add_argument("--max-no-improve", type=int, default=500)
    ap.add_argument("--q-max", type=float, default=0.30)
    ap.add_argument("--eps", type=float, default=1e-7)
    ap.add_argument("--accept", choices=["sa", "descent"], default="sa")
    ap.add_argument("--ls-freq", type=int, default=1, help="0 = sans recherche locale")
    ap.add_argument("--rand-p", type=float, default=4.0, help="<=0 : classement deterministe")
    ap.add_argument("--destroy", default="random,worst,cluster,current")
    ap.add_argument("--repair", default="greedy", help="greedy[,regret2]")
    ap.add_argument("--no-adaptive", action="store_true")
    args, _ = ap.parse_known_args(argv)
    return args


def main(argv=None):
    a = parse_args(argv)
    paths = []
    for x in a.instances:
        if os.path.isdir(x):
            paths += sorted(glob.glob(os.path.join(x, "instance_*.json")))
        else:
            paths.append(x)
    cfg = Config(max_iter=a.max_iter, max_no_improve=a.max_no_improve, time_limit=a.time_limit,
                 q_max=a.q_max, eps=a.eps, accept=a.accept, ls_freq=a.ls_freq,
                 rand_p=(a.rand_p if a.rand_p > 0 else None),
                 destroy_ops=tuple(a.destroy.split(",")), repair_ops=tuple(a.repair.split(",")),
                 adaptive=not a.no_adaptive)
    run_batch(paths, a.runs, cfg, a.out, a.workers, a.resume, a.save_solutions)


if __name__ == "__main__":
    main()
